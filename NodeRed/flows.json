    {
        "id": "190a3299b59dc65c",
        "type": "function",
        "z": "8eedde208e569f58",
        "name": "function 8",
        "func": "let data = msg.payload; \nlet text = \"\";\nlet subject = \"Smart Garage Alert 🚗\";\n\nif (data.event === \"ENTRY\") {\n    text = \"🚗 Garage gate opened and car successfully entered!\\nCard ID: \" + data.card_id;\n    subject = \"Car Entry Notification\";\n} else if (data.event === \"EXIT\") {\n    text = \"👋 A car has left the garage.\\nParking duration: \" + data.duration_sec + \" seconds.\";\n    subject = \"Car Exit Notification\";\n} else if (data.event === \"DENIED_ATTEMPT\") {\n    text = \"🚨 Security Alert! An unauthorized RFID card scan attempt was detected.\\nCard ID: \" + data.card_id;\n    subject = \"Security Alert: Unauthorized Access Attempt!\";\n} else if (data.event === \"PARKING_STATUS\") {\n    text = \"🅿️ Parking status updated: \" + data.card_id;\n    subject = \"Parking Status Update\";\n}\n\nif (text !== \"\") {\n    msg.topic = subject;\n    msg.payload = text;\n    return msg;\n}\n",
