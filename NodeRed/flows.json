    {
        "id": "d99e61a876d3916e",
        "type": "function",
        "z": "8eedde208e569f58",
        "name": "function 7",
        "func": "let rawPayload = msg.payload;\n\n// 1. Parse raw payload safely\nlet msgObj;\ntry {\n    msgObj = typeof rawPayload === \"string\" ? JSON.parse(rawPayload) : rawPayload;\n} catch (e) {\n    node.error(\"Failed to parse JSON: \" + rawPayload);\n    return null;\n}\n\nlet eventType = msgObj.event;\nlet cardId = msgObj.card_id;\nlet duration = msgObj.duration_sec || 0;\n\nlet textMessage = \"\";\nlet telegramMessage = \"\";\nlet gaugeValue = 0;\n\n// 2. Process events\nif (eventType === \"PARKING_STATUS\") {\n    if (cardId === \"EMPTY\") {\n        gaugeValue = 0;\n        textMessage = \"Parking Status: EMPTY (Green LED ON)\";\n        telegramMessage = \"🟢 Garage Status: Completely EMPTY\";\n    } else if (cardId === \"HALF_FULL\") {\n        gaugeValue = 50;\n        textMessage = \"Parking Status: HALF FULL\";\n        telegramMessage = \"🟡 Garage Status: HALF FULL\";\n    } else if (cardId === \"FULL\") {\n        gaugeValue = 100;\n        textMessage = \"Parking Status: FULL (Red LED ON)\";\n        telegramMessage = \"🔴 Garage Status: Completely FULL!\";\n    }\n} else {\n    if (eventType === \"ENTRY\") {\n        textMessage = `Car Entered! Card: ${cardId}`;\n        telegramMessage = `🚗 Car successfully entered\\n- Card ID: ${cardId}`;\n    }\n    else if (eventType === \"EXIT\") {\n        textMessage = `Car Left. Duration: ${duration}s`;\n        telegramMessage = `🚙 Car left the garage\\n- Card ID: ${cardId}\\n- Parking Duration: ${duration} seconds`;\n    }\n    else if (eventType === \"WARNING_TOO_FAR\") {\n        textMessage = `Warning: Car too far from sensor!`;\n        telegramMessage = `⚠️ Warning: Car is too far from the ultrasonic sensor!`;\n    }\n    else if (eventType === \"DENIED_ATTEMPT\") {\n        textMessage = `Access Denied! Unauthorized Card.`;\n        telegramMessage = `❌ Access Denied (Unauthorized Card): ${cardId}`;\n    }\n\n    gaugeValue = null;\n}\n\n// 3. Define your Telegram Chat ID here so the sender node gets it explicitly\nlet myChatId = \"5525837447\";\n\n// Output 1: Telegram Sender (includes chatId, type, and content to avoid any missing property errors)\nlet telegramOut = {\n    payload: {\n        chatId: myChatId,\n        type: \"message\",\n        content: telegramMessage\n    }\n};\n\n// Output 2: Text Dashboard Node\nlet textOut = { payload: textMessage };\n\n// Output 3: Gauge Dashboard Node\nlet gaugeOut = (gaugeValue !== null) ? { payload: gaugeValue } : null;\n\nreturn [telegramOut, textOut, gaugeOut];",
